
# PostgreSQL
POSTGRES_DB=service_center
POSTGRES_ADMIN_USER=course_admin
POSTGRES_ADMIN_PASSWORD=local_admin_password_change_me

REPLICATION_USER=replicator
REPLICATION_PASSWORD=local_replication_password_change_me

APPLICATION_USER=service_app
APPLICATION_PASSWORD=local_app_password_change_me

ANALYST_USER=service_analyst
ANALYST_PASSWORD=local_analyst_password_change_me

# Restore
RESTORE_DB=service_center_restored
RESTORE_ADMIN_PASSWORD=local_restore_password_change_me

# HAProxy
HAPROXY_PORT=55432
HAPROXY_STATS_PORT=8404

# PostgreSQL internal settings
POSTGRES_PORT=5432
PATRONI_REST_PORT=8008

# etcd
ETCD_ROOT_PASSWORD=local_etcd_password_change_me
ETCD_TOKEN=service-center-etcd-cluster
